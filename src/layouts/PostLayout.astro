---
import BaseLayout from './BaseLayout.astro';
import RoverTrail from '~/components/RoverTrail.astro';

interface Artifact {
  label: string;
  url: string;
  type: 'video' | 'pdf' | 'pptx' | 'image' | 'audio' | 'other';
}

interface Props {
  title: string;
  summary: string;
  date: Date;
  lang: 'de' | 'en';
  tags?: string[];
  linkedinUrl?: string;
  codeUrl?: string;
  artifacts?: Artifact[];
  siblingPath?: string;
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
  readingMinutes?: number;
}

const {
  title, summary, date, lang,
  tags = [],
  linkedinUrl, codeUrl, artifacts = [], siblingPath,
  prev, next,
  readingMinutes,
} = Astro.props;

const dateLocale = lang === 'de' ? 'de-DE' : 'en-US';
const dateStr = date.toLocaleDateString(dateLocale, {
  year: 'numeric', month: 'long', day: 'numeric',
});
const linkedinLabel = lang === 'de' ? 'LinkedIn' : 'LinkedIn';
const codeLabel = lang === 'de' ? 'Quellcode' : 'Code';
const artifactsLabel = lang === 'de' ? 'Artefakte' : 'Artifacts';
const transmissionLabel = lang === 'de' ? 'Übertragung' : 'Transmission';
const filedLabel = lang === 'de' ? 'Erfasst' : 'Filed';
const tagsLabel = lang === 'de' ? 'Tags' : 'Tags';
const readingLabel = lang === 'de' ? 'Lesezeit' : 'Reading time';
const minutesShort = lang === 'de' ? 'Min' : 'min';
const prevLabel = lang === 'de' ? '← Vorheriger' : '← Previous';
const nextLabel = lang === 'de' ? 'Nächster →' : 'Next →';
const essayLabel = lang === 'de' ? 'Missionslog' : 'Mission Log';
const filedStripLabel = lang === 'de' ? 'ERFASST' : 'FILED';
const statusStripLabel = lang === 'de' ? 'STATUS · ÜBERTRAGUNG OFFEN' : 'STATUS · OPEN TRANSMISSION';
const readingStr = readingMinutes ? `${readingMinutes} ${minutesShort}` : null;

const typeIcon = (t: Artifact['type']) => ({
  video: '▶', pdf: '📄', pptx: '🗂', image: '🖼', audio: '🔊', other: '↗',
}[t]);
---

<BaseLayout
  lang={lang}
  title={`${title} — marsmike.com`}
  description={summary}
  siblingPath={siblingPath}
  ogType="article"
  shell="post"
  articleDate={date}
  articleTags={tags}
  articleTitle={title}
  articleSummary={summary}
>
  <article class="post-layout">
    <header class="article-hero">
      <div class="console-strip console-strip--article">
        <span>◆ {essayLabel}</span>
        <span>{filedStripLabel} · {dateStr}</span>
        <span>{statusStripLabel}</span>
      </div>
      <div class="article-hero__content">
        <div class="eyebrow">{essayLabel}</div>
        <div class="article-hero__meta">
          <time datetime={date.toISOString()}>{dateStr}</time>
          {readingStr && (
            <>
              <span aria-hidden="true" class="article-hero__meta-sep">·</span>
              <span>{readingStr} {readingLabel}</span>
            </>
          )}
        </div>
        <h1 class="article-hero__title">{title}</h1>
        <p class="article-hero__summary">{summary}</p>
        {tags.length > 0 && (
          <div class="tag-cluster">
            {tags.map((tag) => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>
        )}
        <div class="mt-5">
          <RoverTrail lang={lang} compact={true} />
        </div>
        {(linkedinUrl || codeUrl) && (
          <div class="article-hero__actions">
            {linkedinUrl && (
              <a href={linkedinUrl} class="button-link no-underline">
                {linkedinLabel} ↗
              </a>
            )}
            {codeUrl && (
              <a href={codeUrl} class="button-link no-underline">
                {codeLabel} ↗
              </a>
            )}
          </div>
        )}
      </div>
    </header>

    <div class="article-body-grid">
      <div class="reading-column prose-body">
        <slot />
      </div>
      <aside class="article-sidebox">
        <div class="article-sidebox__top">
          <span class="eyebrow">{transmissionLabel}</span>
          <span class="live-dot live-dot--ok" aria-hidden="true"></span>
        </div>
        <div class="article-sidebox__rows">
          <div class="article-sidebox__row">
            <span class="article-sidebox__label">{filedLabel}</span>
            <span class="article-sidebox__value">{dateStr}</span>
          </div>
          {readingStr && (
            <div class="article-sidebox__row">
              <span class="article-sidebox__label">{readingLabel}</span>
              <span class="article-sidebox__value">{readingStr}</span>
            </div>
          )}
          {tags.length > 0 && (
            <div class="article-sidebox__row">
              <span class="article-sidebox__label">{tagsLabel}</span>
              <span class="article-sidebox__value">{tags.slice(0, 2).join(' · ')}</span>
            </div>
          )}
        </div>
        <div class="mt-5">
          <RoverTrail lang={lang} compact={true} />
        </div>
        {(linkedinUrl || codeUrl) && (
          <div class="article-sidebox__actions">
            {linkedinUrl && (
              <a href={linkedinUrl} class="button-link no-underline">
                {linkedinLabel} ↗
              </a>
            )}
            {codeUrl && (
              <a href={codeUrl} class="button-link no-underline">
                {codeLabel} ↗
              </a>
            )}
          </div>
        )}
        {artifacts.length > 0 && (
          <div class="article-sidebox__artifacts">
            <h2 class="eyebrow mb-3">{artifactsLabel}</h2>
            <ul class="space-y-3 list-none pl-0">
              {artifacts.map((a) => (
                <li>
                  <a href={a.url} class="button-link no-underline">
                    <span aria-hidden="true" class="mr-2">{typeIcon(a.type)}</span>{a.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>

    {(prev || next) && (
      <nav class="post-pagination">
        {prev ? (
          <a href={prev.href} class="pagination-card no-underline">
            <span class="pagination-card__label">{prevLabel}</span>
            <span class="pagination-card__title">{prev.title}</span>
          </a>
        ) : <span class="pagination-card pagination-card--empty"></span>}
        {next ? (
          <a href={next.href} class="pagination-card pagination-card--next no-underline">
            <span class="pagination-card__label">{nextLabel}</span>
            <span class="pagination-card__title">{next.title}</span>
          </a>
        ) : <span class="pagination-card pagination-card--empty"></span>}
      </nav>
    )}
  </article>
</BaseLayout>
